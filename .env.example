# Backend
SECRET_KEY=development-only-change-me
DATABASE_URL=postgresql+psycopg://dancify:dancify@localhost:5432/dancify
DANCIFY_MAX_RAW_MOTION_BATCH=1000

# Scoring (restart the backend after changing; Flask config with the same keys wins)
DANCIFY_SCORING_PROFILE=generous
# Optional bounded overrides; uncomment only for deliberate tuning.
# DANCIFY_SCORING_TIMING_GRACE_SECONDS=0.15
# DANCIFY_SCORING_TIMING_FALLOFF_SECONDS=0.45
# DANCIFY_SCORING_MIN_COVERAGE=0.20
# DANCIFY_SCORING_FULL_COVERAGE=0.65
# DANCIFY_SCORING_RESAMPLE_MAX_GAP_SECONDS=0.10
# DANCIFY_SCORING_DIRECTION_WEIGHT=0.45
# DANCIFY_SCORING_MAGNITUDE_WEIGHT=0.25
# DANCIFY_SCORING_TIMING_WEIGHT=0.30
# DANCIFY_SCORING_SAKOE_CHIBA_RADIUS=18
# DANCIFY_SCORING_COVERAGE_QUALITY_FLOOR=0.70
# DANCIFY_SCORING_SAMPLE_QUALITY_FLOOR=0.85
# DANCIFY_SCORING_TIMING_PATH_COST_WEIGHT=0.35
# DANCIFY_SCORING_SAMPLE_RATE_HZ=50

# Terminal client
DANCIFY_URL=http://127.0.0.1:5000
DANCIFY_TIMEOUT=10
DANCIFY_MOTION_BATCH_SIZE=200
DANCIFY_MOTION_QUEUE_SIZE=4
DANCIFY_DSU_HOST=127.0.0.1
DANCIFY_DSU_PORT=26760
# Blank or omitted means right-controller-only mode.
DANCIFY_DSU_LEFT_SLOT=
DANCIFY_DSU_RIGHT_SLOT=1
DANCIFY_DSU_STALE_AFTER=1
